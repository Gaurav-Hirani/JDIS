# JDIS Backend Configuration
PROJECT_NAME="Judicial Delay Intelligence System (JDIS)"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="jdis_user"
POSTGRES_PASSWORD="jdis_password"
POSTGRES_DB="jdis_db"
DATABASE_URL="postgresql://jdis_user:jdis_password@localhost:5432/jdis_db"

# Model Paths
MODEL_CLASSIFIER_PATH="models/final_calibrated_clf.joblib"
MODEL_REGRESSOR_PATH="models/best_ablation_reg.joblib"
MODEL_VERSION="v1.0-config-d"

# CORS Configuration (comma-separated list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"
